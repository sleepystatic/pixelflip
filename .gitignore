# Dependencies
node_modules/

# Next.js build output
.next/
out/

# Environment variables (SENSITIVE!)
# `.env*` rather than an explicit list: a backup like .env.local.backup-20260807
# holds every secret from the file it copied, and none of the exact-name
# patterns below match it. GitHub push protection caught exactly that once.
.env*
!.env.example

# Database files (CONTAINS USER EMAILS!)
*.db
*.sqlite
*.sqlite3
waitlist.db

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/

# Exports (contains emails)
*.csv
waitlist-export.csv

# Vercel
.vercel